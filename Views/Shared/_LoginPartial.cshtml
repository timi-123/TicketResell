@using Microsoft.AspNetCore.Identity
@using TicketResell.Models

@inject SignInManager<ApplicationUser> SignInManager

@{
    var currentAction = ViewContext.RouteData.Values["controller"]?.ToString() == "Orders"
        ? ViewContext.RouteData.Values["action"]?.ToString()
        : null;
}

<ul class="navbar-nav site-nav account-nav align-items-md-center">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link @(currentAction == "MyOrders" ? "active" : "")" asp-area="" asp-controller="Orders" asp-action="MyOrders">My orders</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentAction == "Sales" ? "active" : "")" asp-area="" asp-controller="Orders" asp-action="Sales">My sales</a>
    </li>
    <li class="nav-item">
        <a id="manage" class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage your account">Account</a>
    </li>
    <li class="nav-item">
        <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button id="logout" type="submit" class="nav-link">Log out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" id="login" asp-area="Identity" asp-page="/Account/Login">Log in</a>
    </li>
    <li class="nav-item ms-md-2">
        <a class="btn btn-sm btn-primary" id="register" asp-area="Identity" asp-page="/Account/Register">Create account</a>
    </li>
}
</ul>
