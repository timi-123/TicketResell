@model TicketResell.Models.TicketListing
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Sell tickets";
    var eventItems = (List<SelectListItem>)ViewData["EventId"]!;
}

<a asp-action="Index" class="back-link">← Tickets</a>

<div class="form-narrow">
    <h1 class="page-title">Sell tickets</h1>
    <p class="page-subtitle">List seats you can't use. Buyers pay the price you set.</p>

    <form asp-action="Create" class="mt-4">
        <div asp-validation-summary="ModelOnly"></div>

        <div class="mb-3">
            <label asp-for="EventId" class="form-label"></label>
            <select asp-for="EventId" class="form-select">
                @foreach (var item in eventItems)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            </select>
            <span asp-validation-for="EventId"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-7">
                <label asp-for="PricePerTicket" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="PricePerTicket" type="number" step="0.01" min="0.01" class="form-control" />
                </div>
                <span asp-validation-for="PricePerTicket"></span>
            </div>
            <div class="col-sm-5">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" min="1" class="form-control" />
                <span asp-validation-for="Quantity"></span>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-sm-7">
                <label asp-for="Section" class="form-label"></label>
                <input asp-for="Section" class="form-control" />
                <span asp-validation-for="Section"></span>
            </div>
            <div class="col-sm-5">
                <label asp-for="Row" class="form-label"></label>
                <input asp-for="Row" class="form-control" />
                <span asp-validation-for="Row"></span>
            </div>
        </div>
        <p class="form-hint">Leave section and row empty for unreserved seating.</p>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">List tickets</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
