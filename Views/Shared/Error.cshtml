@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="prose">
    <h1 class="page-title">Something went wrong</h1>
    <p class="page-subtitle">An error occurred while processing your request. Please try again.</p>

    @if (Model.ShowRequestId)
    {
        <p class="subtle mt-4">Request ID: <code>@Model.RequestId</code></p>
    }
</div>
