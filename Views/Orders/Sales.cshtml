@model IEnumerable<TicketResell.Models.Order>

@{
    ViewData["Title"] = "My sales";
}

<div class="page-header">
    <div>
        <h1 class="page-title">My sales</h1>
        <p class="page-subtitle">Tickets other people bought from your listings.</p>
    </div>
    <a asp-controller="TicketListings" asp-action="Create" class="btn btn-secondary">Sell tickets</a>
</div>

@if (!Model.Any())
{
    <div class="empty">
        Nobody has bought from your listings yet.
        <a asp-controller="TicketListings" asp-action="Create">List some tickets</a>.
    </div>
}
else
{
    <div class="table-scroll">
        <table class="table-clean">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Buyer</th>
                    <th class="end">Tickets</th>
                    <th class="end">Payout</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>
                        <div class="cell-title">@order.TicketListing?.Event?.Title</div>
                        <div class="cell-sub">@order.TicketListing?.Event?.Venue?.Name · @order.TicketListing?.SeatDescription</div>
                    </td>
                    <td>
                        <div>@order.Buyer?.FirstName @order.Buyer?.LastName</div>
                        <div class="cell-sub">Ordered @order.OrderedAt.ToString("d MMM")</div>
                    </td>
                    <td class="end">@order.Quantity</td>
                    <td class="end">@order.SellerPayout.ToString("C")</td>
                    <td><span class="status status-@order.OrderStatus.ToString().ToLowerInvariant()">@order.OrderStatus</span></td>
                    <td class="end text-nowrap">
                        @if (order.OrderStatus == OrderStatus.Paid)
                        {
                            <a asp-action="Deliver" asp-route-id="@order.Id" class="btn btn-sm btn-primary">Send tickets</a>
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-secondary">View</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
