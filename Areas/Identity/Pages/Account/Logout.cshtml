@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="auth">
    <h1 class="page-title">Log out</h1>
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <form class="mt-4" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
            <button type="submit" class="btn btn-primary">Log out</button>
        </form>
    }
    else
    {
        <p class="page-subtitle">You're logged out.</p>
    }
</div>
