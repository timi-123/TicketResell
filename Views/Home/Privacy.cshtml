@{
    ViewData["Title"] = "Privacy";
}

<div class="prose">
    <h1 class="page-title">Privacy</h1>
    <p class="page-subtitle">What we store and why.</p>

    <p class="mt-4">
        When you create an account we keep your name, email, address and city. Your email and password are used to
        log you in. Your name is shown to people who buy from you or sell to you.
    </p>
    <p>
        We keep a record of the tickets you list and the orders you place, so that both sides of a sale can see it later.
    </p>
</div>
